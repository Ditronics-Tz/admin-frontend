# Rida Admin Dashboard - Environment Configuration Example
# Copy this file to .env.local for local overrides.

# API Base URL for backend services (Go Fiber service running on port 3000)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Enable/disable development demo preview mode fallback (strictly false in production)
VITE_ENABLE_DEMO_MODE=false

# Development-only HTTP fixture adapter. Production always uses live APIs.
VITE_API_MODE=live

# HTTPS origin used by private document presigned reads (no credentials here).
VITE_DOCUMENT_ORIGIN=

# Production maps require a licensed tile template and its attribution.
# Example: https://tiles.example.invalid/{z}/{x}/{y}.png
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Environment name: development | staging | production
VITE_APP_ENV=development

# Application default locale (en | sw)
VITE_DEFAULT_LOCALE=en
