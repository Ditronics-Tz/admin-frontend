# Rida Admin Dashboard - Environment Configuration Example
# Copy this file to .env.local for local overrides.

# API Base URL for backend services (Go Fiber service running on port 3000)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Enable/disable development demo preview mode fallback (strictly false in production)
VITE_ENABLE_DEMO_MODE=false

# Environment name: development | staging | production
VITE_APP_ENV=development

# Application default locale (en | sw)
VITE_DEFAULT_LOCALE=en
